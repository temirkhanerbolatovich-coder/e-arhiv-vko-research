  errors jsonb [not null]
  status text [not null, note: 'pending, valid, needs_review, rejected, imported']
  resource_id uuid [null]
  indexes {
    (batch_id, row_locator) [unique]
  }
}

Table legacy_redirects {
  Note: 'Переходы со старых страниц. '
  id uuid [pk, not null, note: 'Постоянный идентификатор; PK']
  old_url text [not null]
  resource_id uuid [not null]
  locale text [not null]
  indexes {
    (old_url) [unique]
  }
}

Table search_chunks {
  Note: 'Перестраиваемые фрагменты разрешённых источников. '
  id uuid [pk, not null, note: 'Постоянный идентификатор; PK']
  revision_id uuid [not null]
  ocr_version_id uuid [null]
  chunk_no integer [not null]
  language text [not null]
  text text [not null]
  text_hash text [not null]
  locator text [null]
  pipeline_version text [not null]
  created_at timestamptz [not null]
  indexes {
    (revision_id, pipeline_version, chunk_no) [unique]
  }
}

Table embedding_models {
  Note: 'Версии моделей смыслового поиска. '
  id uuid [pk, not null, note: 'Постоянный идентификатор; PK']
  model_key text [not null]
  dimensions integer [not null]
  revision text [not null]
  active boolean [not null]
  indexes {
    (model_key, revision) [unique]
  }
}

Table chunk_embeddings {
  Note: 'Векторные представления фрагментов. vector без размерности — логический placeholder. В миграции отдельный согласованный размер и индекс для выбранной модели.'
  id uuid [pk, not null, note: 'Постоянный идентификатор; PK']
  chunk_id uuid [not null]
  model_id uuid [not null]
  embedding vector [not null]
  indexes {
    (chunk_id, model_id) [unique]
  }
}

Table chat_sessions {
  Note: 'Анонимные сессии с ограниченным хранением. '
  id uuid [pk, not null, note: 'Постоянный идентификатор; PK']
  token_hash text [not null]
  locale text [not null]
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  indexes {
    (token_hash) [unique]
  }
}

Table chat_messages {
  Note: 'Сообщения разговора. '
  id uuid [pk, not null, note: 'Постоянный идентификатор; PK']
  session_id uuid [not null]
  sequence_no integer [not null]
  role text [not null, note: 'user, assistant']
  body text [not null]
  status text [not null, note: 'pending, completed, failed']
  model_revision text [null]
  created_at timestamptz [not null]
  indexes {
    (session_id, sequence_no) [unique]
  }
}

Table message_citations {
  Note: 'Проверяемые источники ответа. Если chunk задан, он принадлежит указанной revision. Источник при открытии снова проходит проверку доступа.'
  id uuid [pk, not null, note: 'Постоянный идентификатор; PK']
  message_id uuid [not null]
  revision_id uuid [not null]
  chunk_id uuid [null]
  source_text_hash text [not null]
  locator text [null]
  position integer [not null]
  indexes {
    (message_id, position) [unique]
  }
}

Table answer_feedback {
  Note: 'Оценка полезности ответа. Оценивать может только владелец сессии; rating -1 или 1.'
  id uuid [pk, not null, note: 'Постоянный идентификатор; PK']
  message_id uuid [not null]
  rating smallint [not null]
  reason_code text [null]
  created_at timestamptz [not null]
  indexes {
    (message_id) [unique]
  }
}

Table search_events {
  Note: 'Минимальная обезличенная аналитика. Не сохраняет IP, контакты, идентификатор сессии или сырые вопросы по умолчанию.'
  id uuid [pk, not null, note: 'Постоянный идентификатор; PK']
  locale text [not null]
  intent_code text [null]
  query_redacted text [null]
  result_count integer [not null]
  clicked_resource_id uuid [null]
  latency_ms integer [not null]
  occurred_at timestamptz [not null]
}

Table index_jobs {
  Note: 'Надёжное обновление поискового индекса. Публикация и запись задания — одна транзакция. Ошибка индекса не открывает старый закрытый контент.'
  id uuid [pk, not null, note: 'Постоянный идентификатор; PK']
  resource_id uuid [not null]
  requested_version bigint [not null]
  status text [not null]
  attempts integer [not null]
  available_at timestamptz [not null]
  last_error_code text [null]
}

