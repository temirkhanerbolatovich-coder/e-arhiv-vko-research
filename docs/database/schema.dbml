Project archive_vko {
  database_type: 'PostgreSQL'
}

Table resources {
  Note: 'Единая идентичность публикуемого материала. Не содержит произвольных бизнес-полей. Один соответствующий типу подтип. Права не определяются одним наличием URL.'
