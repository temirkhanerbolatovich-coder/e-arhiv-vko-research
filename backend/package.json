{
  "name": "archive-vko-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API, поиск и ИИ-помощник информационного сайта Государственного архива ВКО",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build:seed": "tsx scripts/build-seed.ts",
    "build:db": "tsx scripts/build-db.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "build:vercel": "tsx scripts/build-vercel.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@hono/node-server": "2.1.7",
    "hono": "4.13.18",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "xlsx": "0.18.5"
  }
}
