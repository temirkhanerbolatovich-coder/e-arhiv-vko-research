# Скопируйте в backend/.env (файл не коммитится) или задайте в окружении.
PORT=4173
HOST=127.0.0.1
# PostgreSQL для эксплуатации. Пусто — PGlite в памяти из снимка data/snapshot.
DATABASE_URL=
# Ключ OpenAI. Пусто — помощник работает обычным поиском (на Vercel — через AI Gateway).
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_MS=20000
# Обязателен при NODE_ENV=production. Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
# Пароль демо-учёток. Только для демонстрационного стенда.
DEMO_PASSWORD=archive-demo-2026
